rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown access
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kaushik6715@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health / Connection probe collection
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Scans collection (Telemetry & forensic scam reports)
    match /scans/{scanId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() && (
        (resource.data.userId == request.auth.uid) || isAdmin()
      );
    }
  }
}
